# binaries, outputs and build trees are not tracked; configs, scripts, run records and small results are
usecases/*/bin/*
!usecases/*/bin/.gitkeep
usecases/*/runs
build/trees/
*.o
*.d
__pycache__/
usecases/*/reference/*.pdf
# generated by common/build_configs.py from base + overrides.csv (rebuild any time)
usecases/*/config/*.xml
usecases/*/config/cells_*.csv
checks/
usecases/*/runs_*/
/local_archive/
usecases/*/config/shipped/
