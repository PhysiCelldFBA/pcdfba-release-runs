+// the quadrant x >= 0, y >= 0 of the disc built by create_cell_disc_positions (same rows, same spacing, same cells)
+std::vector<std::vector<double>> create_cell_quarter_disc_positions(double cell_radius, double disc_radius)
+{
+	double cell_spacing = 0.95 * 2.0 * cell_radius;
+
+	double x = 0.0;
+	double y = 0.0;
+	double x_outer = 0.0;
+
+	std::vector<std::vector<double>> positions;
+	std::vector<double> tempPoint(3,0.0);
+
+	int n = 0;
+	while( y < disc_radius )
+	{
+		x = 0.0;
+		if( n % 2 == 1 )
+		{ x = 0.5 * cell_spacing; }
+		x_outer = sqrt( disc_radius*disc_radius - y*y );
+
+		while( x < x_outer )
+		{
+			tempPoint[0]= x; tempPoint[1]= y;	tempPoint[2]= 0.0;
+			positions.push_back(tempPoint);
+			x += cell_spacing;
+		}
+		y += cell_spacing * sqrt(3.0)/2.0;
+		n++;
+	}
+	return positions;
+}
